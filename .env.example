# Safe local defaults. Never place production secrets or real personal data here.
PORT=3000
HOST=127.0.0.1
DEMO_MODE=true
PUBLIC_BASE_URL=http://127.0.0.1:3000

# Required only when HOST=0.0.0.0. Comma-separated, without scheme or path.
ALLOWED_HOSTS=localhost,127.0.0.1
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
