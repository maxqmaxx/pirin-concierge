{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pirin-concierge.example/schemas/experience.schema.json",
  "title": "Pirin Concierge synthetic experience",
  "description": "A synthetic, request-only experience record for the TRL 4 laboratory demonstrator.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "slug",
    "name",
    "description",
    "category",
    "settlement",
    "languages",
    "durationMinutes",
    "indicativePrice",
    "host",
    "availability",
    "synthetic",
    "bookingMode",
    "confirmationMode",
    "paymentMode"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^exp-[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "name": {
      "type": "string",
      "minLength": 3,
      "maxLength": 120
    },
    "description": {
      "type": "string",
      "minLength": 20,
      "maxLength": 500
    },
    "category": {
      "type": "string",
      "enum": ["craft", "culinary", "heritage", "nature"]
    },
    "settlement": {
      "type": "string",
      "enum": ["Bansko", "Razlog", "Banya", "Dobarsko"]
    },
    "languages": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z]{2}$"
      }
    },
    "durationMinutes": {
      "type": "integer",
      "minimum": 30,
      "maximum": 480
    },
    "indicativePrice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["amount", "currency"],
      "properties": {
        "amount": {
          "type": "number",
          "minimum": 0,
          "multipleOf": 0.01
        },
        "currency": {
          "const": "EUR"
        }
      }
    },
    "host": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "displayName", "synthetic"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^host-demo-[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "displayName": {
          "type": "string",
          "pattern": "^Synthetic Host "
        },
        "synthetic": {
          "const": true
        }
      }
    },
    "availability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "note"],
      "properties": {
        "mode": {
          "const": "by_request"
        },
        "note": {
          "type": "string",
          "minLength": 20,
          "maxLength": 240
        }
      }
    },
    "synthetic": {
      "const": true
    },
    "bookingMode": {
      "const": "request_only"
    },
    "confirmationMode": {
      "const": "host_required"
    },
    "paymentMode": {
      "const": "off_platform_direct_to_host"
    }
  }
}
